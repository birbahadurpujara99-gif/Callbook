{
  "entities": {
    "users": {
      "title": "User Profile",
      "description": "Registered user profile with email, mobile phone number, name, bio, and avatar",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "photoUrl": { "type": "string" },
        "bio": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["uid", "name", "email", "phone"]
    },
    "posts": {
      "title": "Social Post",
      "description": "User created post with optional photo and text",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorPhotoUrl": { "type": "string" },
        "text": { "type": "string" },
        "photoBase64": { "type": "string" },
        "likeCount": { "type": "integer" },
        "likedUserIds": { "type": "array", "items": { "type": "string" } },
        "commentCount": { "type": "integer" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "authorId", "authorName", "createdAt"]
    },
    "comments": {
      "title": "Post Comment",
      "description": "Comment attached to a post",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "postId": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorPhotoUrl": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "postId", "authorId", "authorName", "text", "createdAt"]
    }
  }
}
